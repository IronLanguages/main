<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="$(ProjectDir)..\..\Solutions\Common.proj" />

  <PropertyGroup>
    <TargetFrameworks>net35;net40;net45;netcoreapp2.0</TargetFrameworks>
    <PlatformTarget>anycpu</PlatformTarget>
    <ProjectGuid>{02FF0909-F5AD-48CF-A86A-345E721B7E40}</ProjectGuid>
    <OutputType>Library</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>Microsoft.Scripting</RootNamespace>
    <AssemblyName>Microsoft.Scripting</AssemblyName>
    <BaseAddress>857735168</BaseAddress>
    <CodeAnalysisRuleSet>$(AssemblyName).ruleset</CodeAnalysisRuleSet>
    <DocumentationFile>$(OutputPath)\$(AssemblyName).xml</DocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Runtime\DynamicOperations.Generated.cs" />
    <Compile Include="..\..\Hosts\Silverlight\SilverlightVersion.cs" Link="Properties\SilverlightVersion.cs" Condition=" '$(IsSilverlight)' == 'true' " />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Microsoft.Scripting.Core\Microsoft.Scripting.Core.csproj" Condition=" !$(Features.Contains('FEATURE_CORE_DLR')) " />
    <Reference Include="System.Configuration" Condition=" $(Features.Contains('FEATURE_CONFIGURATION')) " />
    <Reference Include="System.Runtime.Remoting" Condition=" $(Features.Contains('FEATURE_REMOTING')) " />
  </ItemGroup>
</Project>
